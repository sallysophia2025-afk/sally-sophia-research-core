{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SallySophiaDublinCoreRecord",
  "type": "object",
  "required": ["identifier", "title", "subject", "description", "publisher", "date", "type", "rights"],
  "properties": {
    "identifier": { "type": "string", "pattern": "^CLM-[A-Z]+-[0-9]+$" },
    "source_identifier": { "type": "string" },
    "title": { "type": "string", "minLength": 5 },
    "subject": { "type": "string" },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "coverage": { "type": "string" },
    "authority": { "type": "string" },
    "date": { "type": "string" },
    "type": { "type": "string" },
    "rights": { "type": "string" }
  },
  "additionalProperties": true
}
